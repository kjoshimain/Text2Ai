# Backend server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=32kb

# Input and abuse protection
MAX_INBOUND_CHARS=1000
DEFAULT_COUNTRY_CODE=91
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_PHONE_MAX=5
RATE_LIMIT_IP_MAX=120

# SMS formatting and gateway queue
MAX_SMS_SEGMENTS=3
PAIRING_CODE_TTL_MS=600000
# Required to issue pairing codes or administer paired devices; use a random value of at least 32 bytes.
GATEWAY_PAIRING_SECRET=
OUTBOX_LONG_POLL_MS=25000
OUTBOX_EXPIRY_MS=600000

# Privacy cleanup
RETENTION_DAYS=30

# Research providers
RESEARCH_TIMEOUT_MS=40000
TINYFISH_API_KEY=
TINYFISH_TIMEOUT_MS=20000
TINYFISH_RETRIES=2
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_MS=15000
LLM_RETRIES=1

# Optional persistence; both values are required to enable Supabase
SUPABASE_URL=
SUPABASE_KEY=

# SMS provider; mock is the working default
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
